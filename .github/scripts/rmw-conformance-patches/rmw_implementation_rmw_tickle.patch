+    // skip fixture-wide here rather than repeating the same rmw_get_implementation_identifier()
+    // check in each of the 4 TEST_F()s below (same idea as this file's own existing rmw_
+    // connextdds-specific skips, just at fixture scope instead of per-test).
+    if (std::string(rmw_get_implementation_identifier()).find("rmw_tickle") == 0) {
+      GTEST_SKIP();
+    }
   }
 
   void TearDown() override
