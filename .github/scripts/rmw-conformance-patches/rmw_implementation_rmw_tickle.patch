     ASSERT_NE(nullptr, node) << rcutils_get_error_string().str;
+
+    // Local, rmw_tickle-specific patch (not upstream): rmw_publisher_event_init()/rmw_
+    // subscription_event_init() both unconditionally return RMW_RET_UNSUPPORTED (no QoS event
