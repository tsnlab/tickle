+# Local, rmw_tickle-specific patch (not upstream): rosidl_generate_interfaces() below runs each
+# registered typesupport's own CMake extension in *registration* order, decided by find_package()
+# call order - rosidl_typesupport_tickle_cpp's own extension needs rosidl_typesupport_tickle_c's
+# to have already run, and already find_package()s it first internally for exactly this reason,
+# but whatever generic mechanism gets either of our two typesupports discovered at all for a
+# package that never names either one explicitly (this one doesn't) has no ordering guarantee
+# between packages it discovers this way. Moving the swap here, *before* find_package(rosidl_
+# default_generators) below (not just before rosidl_generate_interfaces() itself, where this was
+# tried first and didn't help) matters: find_package() only actually processes a package's own
+# Config/extras files - and only then runs ament_register_extension() - the *first* time it's
+# resolved in a given configure; a package rosidl_default_generators' own transitive discovery
+# already resolved earlier ignores a later, explicit find_package() call as a no-op, registration
+# order and all. rmw_tickle's own rosidl_typesupport_tickle_c_tests sidesteps the whole question
+# by depending on neither rosidl_default_generators nor any transitive discovery that could beat
+# it to the punch. Found via two real CI failures - the second one is what pinned this down to
+# the "goes first, not just resolved" requirement specifically.
+find_package(rosidl_typesupport_tickle_c REQUIRED)
+find_package(rosidl_typesupport_tickle_cpp REQUIRED)
+
 find_package(ament_cmake REQUIRED)
 find_package(builtin_interfaces REQUIRED)
 find_package(rosidl_default_generators REQUIRED)
 find_package(test_interface_files REQUIRED)
 
 # TODO(sloretz) Change to test_msgs_interfaces when ros2/rosidl_typesupport#120 is fixed
+# Local, rmw_tickle-specific patch (not upstream): rosidl_typesupport_tickle_c does not support
+# nested message types, arrays of nested types, or wstring yet - exclude the test_interface_files
+# messages that use them, keeping only the flat/plain-type subset rmw_tickle can actually generate
+# typesupport for (mirrors README-rmw-perf.md's own Struct256.msg exclusion for the same reason).
+list(FILTER test_interface_files_MSG_FILES EXCLUDE REGEX
+  ".*/(Nested|MultiNested|Arrays|WStrings|BoundedPlainSequences|BoundedSequences|UnboundedSequences)\\.msg$")
 rosidl_generate_interfaces(test_msgs
   ${test_interface_files_MSG_FILES}
-  ${test_interface_files_SRV_FILES}
-  ${test_interface_files_ACTION_FILES}
-  ${test_interface_files_IDL_FILES}
-  "msg/Builtins.msg"
-  "action/NestedMessage.action"
   DEPENDENCIES builtin_interfaces
   ADD_LINTER_TESTS
 )
