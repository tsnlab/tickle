@@ -22,13 +22,22 @@ find_package(rosidl_default_generators REQUIRED)
 find_package(test_interface_files REQUIRED)
 
 # TODO(sloretz) Change to test_msgs_interfaces when ros2/rosidl_typesupport#120 is fixed
+# Local, rmw_tickle-specific patch (not upstream): rosidl_typesupport_tickle_c does not support
+# nested message types, arrays of nested types, or wstring yet - exclude the test_interface_files
+# messages that use them, keeping only the flat/plain-type subset rmw_tickle can actually generate
+# typesupport for (mirrors README-rmw-perf.md's own Struct256.msg exclusion for the same reason).
+# Also drops ACTION/IDL files and the two action-only entries below (msg/Builtins.msg,
+# action/NestedMessage.action) - rmw_tickle has no action support at all (see rmw_client.c/
+# rmw_service.c). SRV_FILES is kept (rosidl_typesupport_tickle_cpp now generates .srv typesupport
+# too - rmw_tickle/PLAN.md's Milestone 11 row), filtered the same way: Arrays.srv uses arrays of
+# nested message types (BasicTypes[3]/Constants[3]/Defaults[3]), the same unsupported grammar as
+# the excluded .msg files above - BasicTypes.srv/Empty.srv are both flat/plain-type and kept.
+list(FILTER test_interface_files_MSG_FILES EXCLUDE REGEX
+  ".*/(Nested|MultiNested|Arrays|WStrings|BoundedPlainSequences|BoundedSequences|UnboundedSequences)\\.msg$")
+list(FILTER test_interface_files_SRV_FILES EXCLUDE REGEX ".*/Arrays\\.srv$")
 rosidl_generate_interfaces(test_msgs
   ${test_interface_files_MSG_FILES}
   ${test_interface_files_SRV_FILES}
-  ${test_interface_files_ACTION_FILES}
-  ${test_interface_files_IDL_FILES}
-  "msg/Builtins.msg"
-  "action/NestedMessage.action"
   DEPENDENCIES builtin_interfaces
   ADD_LINTER_TESTS
 )
