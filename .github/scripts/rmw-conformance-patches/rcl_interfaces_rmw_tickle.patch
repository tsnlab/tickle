diff --git a/rcl_interfaces/srv/SetParameters.srv b/rcl_interfaces/srv/SetParameters.srv
index 97d1179..9abeff1 100644
--- a/rcl_interfaces/srv/SetParameters.srv
+++ b/rcl_interfaces/srv/SetParameters.srv
@@ -1,6 +1,29 @@
+# Local, rmw_tickle-specific patch (not upstream) - see check-all.yml's own real rcl_interfaces
+# build step (rmw_tickle/PLAN.md's Milestone for it) for why this package needs to actually build
+# with rosidl_typesupport_tickle_c at all, not just ship the /parameter_events message set
+# (ParameterValue.msg's own header comment covers that earlier, narrower need). Two different,
+# unrelated-to-each-other limitations than ParameterValue.msg's own ("multiple variable arrays in
+# one struct"), both surfacing across rcl_interfaces' own real .srv shapes: (1) an unbounded array
+# of a *nested message type that is itself not fixed-size* (Parameter, which nests ParameterValue -
+# this field) can't have its capacity auto-derived at all, regardless of how many other arrays
+# share the struct, since there's no fixed per-element wire size to divide a byte budget by; (2) a
+# bare 'string[] field' (adapt.py's own _resolve_auto_capacities()) can *never* auto-derive either,
+# even alone/first in a struct - a string's own wire size varies per instance, so there's no fixed
+# per-element size to divide by there either (this is genuinely different from Milestone 7's own
+# already-working array-of-string support, which is about *bounded* string arrays or ones with an
+# explicit annotation - auto-derivation specifically was never meant to cover strings, fixed-size-
+# element arrays like int64[]/bool[]/byte[] are the only kind it ever handles). Every rcl_interfaces
+# .srv/.msg field hitting either shape (a plain '<Message>[] f'/'string[] f', no explicit ROS 2
+# upper bound of its own, no annotation) gets the same explicit annotation, 8 as a deliberately
+# generous but arbitrary default (this is about making the package *build*, not about a specific
+# real workload's own batch size - widen per-field if one ever needs more). The nested-array half
+# ((1) above) goes away on its own once TickLE's own array-of-nested-message-type auto-derivation
+# lands (rmw_tickle/PLAN.md's own Milestone 38 array follow-on); the string-array half (2) is a
+# permanent, by-design limit, not a gap anything is expected to later close - either way, an
+# explicit annotation stays harmless to keep, just redundant once/if (1) ever lands.
 # A list of parameters to set.
-Parameter[] parameters
+Parameter[] parameters  # @capacity 8
 
 ---
 # Indicates whether setting each parameter succeeded or not and why.
-SetParametersResult[] results
+SetParametersResult[] results  # @capacity 8
