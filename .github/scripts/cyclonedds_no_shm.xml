<?xml version="1.0" encoding="UTF-8"?>
<!--
  Explicitly disables CycloneDDS's own optional shared-memory (Iceoryx-backed) transport, for the
  same reason fastdds_udp_only.xml disables FastDDS's own default one - see that file's own
  comment. CycloneDDS's SharedMemory support is opt-in (needs Iceoryx compiled in) so this install
  may already have it off by default - included anyway so the comparison run's own config is
  explicit and self-documenting rather than relying on an assumed default. Set via CYCLONEDDS_URI
  (a file:// URI pointing here, or this content inlined directly into that env var).

  NOTE: not yet verified against this rig's actual installed CycloneDDS version's own real XML
  schema/defaults - check its own transport-selection logging once run for real before trusting
  any benchmark numbers that depend on this actually taking effect.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain>
    <SharedMemory>
      <Enable>false</Enable>
    </SharedMemory>
    <!--
      Keep discovery on loopback (2026-09-23, a measured incident, not a precaution). Unpinned,
      CycloneDDS selects its interface from the default route, which on this box is the LAN - the
      same L2 segment the rig Pis reach via wlan0, where the rig's own CycloneDDS scenarios also run
      unpinned and on the same default domain 0. The two then discover each other, and a second
      writer on the same topic injects its own sample ids: a run here aborted with "Data consistency
      violated. Received sample with not strictly higher id. Received sample id 100 Prev. sample
      id : 7146", which is a second publisher, not a middleware defect. Both processes of this
      benchmark are on one box, so loopback is the correct scope - the same reasoning as
      TICKLE_BROADCAST_ADDR=127.255.255.255 in compare_rmw_perf.sh and the interfaceWhiteList in
      fastdds_udp_only.xml. compare_rmw_perf.sh also sets a distinct ROS_DOMAIN_ID as an
      independent second barrier, because a domain collision and an interface collision fail
      differently.
    -->
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="true"/>
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
