<?xml version="1.0" encoding="UTF-8"?>
<!--
  Forces FastDDS onto real UDPv4, disabling its default shared-memory transport.

  Used only for the one-off rmw_tickle-vs-FastDDS-vs-CycloneDDS comparison (rmw-perf.yml's own
  compare_dds_vendors workflow_dispatch input), not the standing rmw_tickle-only regression job.
  Without this, FastDDS auto-negotiates a same-host shared-memory transport that bypasses the
  kernel UDP/IP stack entirely - rmw_tickle has no such shortcut (hal_linux.c's own plain UDP
  sockets), so a same-host benchmark would silently favor FastDDS for reasons that have nothing
  to do with either implementation's own real efficiency (rmw_tickle/PLAN.md's Milestone 14 own
  finding, the reason this rig dropped DDS vendors from its standing comparison in the first
  place).

  useBuiltinTransports=false + an explicit UDPv4-only userTransports list is FastDDS's own
  documented mechanism for this. Set via the FASTRTPS_DEFAULT_PROFILES_FILE environment variable.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
