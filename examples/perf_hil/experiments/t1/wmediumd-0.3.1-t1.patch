+/*
+ * Gilbert-Elliott overlay (local patch, for TickLE wireless T1 only).
+ * WM_GE="good_ms,bad_ms,good_p": every directed link flips independently between a
+ * GOOD state (error probability good_p) and a BAD state (the link value in the
+ * config). Sojourn times are exponential with the given means. Unset: no overlay.
+ */
+#include <time.h>
+struct ge_state { int bad; double until_ms; int busy; double env_until_ms; unsigned short xs[3]; };
+/* WM_SEED set: every link draws its sojourns from its own generator (seeded from WM_SEED and the link) and all links count
+ * time from the first frame of at least 150 bytes (the benchmark payload), so two runs with the same seed see the same
+ * good/bad schedule whatever the order of the queries. */
+static int ge_seeded = -1;
+static long ge_seed;
+static double ge_origin_ms;
+static struct ge_state *ge_st;
+static double ge_good_ms, ge_bad_ms, ge_good_p;
+static double ge_quiet_s, ge_busy_s, ge_busy_k = 1.0; /* optional slow envelope */
+static int ge_on = -1;
+
+double wm_attempt_ms; /* simulated time already spent on the frame being decided (set by wmediumd.c) */
+static int wm_per_attempt = -1;
+int wm_attempt_mode(void)
+{
+	if (wm_per_attempt < 0) {
+		const char *e = getenv("WM_RETRY");
+		wm_per_attempt = e && *e == '1';
+	}
+	return wm_per_attempt;
+}
+
+static double ge_now_ms(void)
+{
+	struct timespec t;
+	clock_gettime(CLOCK_MONOTONIC, &t);
+	return t.tv_sec * 1e3 + t.tv_nsec / 1e6;
+}
+
+static double ge_exp(struct ge_state *g, double mean)
+{
+	return -mean * log(1.0 - (ge_seeded > 0 ? erand48(g->xs) : drand48()));
+}
+
+int wm_frame_len;
+static double ge_overlay(struct wmediumd *ctx, int s, int d, double bad_p)
+{
+	struct ge_state *g;
+	double now;
+
+	if (ge_on < 0) {
+		const char *e = getenv("WM_GE");
+		int n = e ? sscanf(e, "%lf,%lf,%lf,%lf,%lf,%lf", &ge_good_ms, &ge_bad_ms, &ge_good_p,
+				   &ge_quiet_s, &ge_busy_s, &ge_busy_k) : 0;
+		ge_on = n == 3 || n == 6;
+		if (n == 3)
+			ge_quiet_s = 0;
+		if (ge_on)
+			ge_st = calloc(ctx->num_stas * ctx->num_stas, sizeof(*ge_st));
+	}
+	if (!ge_on)
+		return bad_p;
+	if (ge_seeded < 0) {
+		const char *e = getenv("WM_SEED");
+		ge_seed = e ? atol(e) : 0;
+		ge_seeded = ge_seed > 0;
+	}
+	if (ge_seeded > 0 && ge_origin_ms == 0) {
+		if (wm_frame_len < 150)
+			return ge_good_p; /* before the payload starts: good state, nothing scheduled yet */
+		ge_origin_ms = ge_now_ms();
+	}
+	g = &ge_st[ctx->num_stas * s + d];
+	now = (ge_seeded > 0 ? ge_now_ms() - ge_origin_ms + 1.0 : ge_now_ms()) + wm_attempt_ms;
+	if (g->until_ms == 0) {
+		g->bad = 0;
+		if (ge_seeded > 0) {
+			g->xs[0] = (unsigned short)(ge_seed & 0xffff);
+			g->xs[1] = (unsigned short)((ge_seed >> 16) & 0xffff);
+			g->xs[2] = (unsigned short)(s * 64 + d + 1);
+		}
+		g->until_ms = now + ge_exp(g, ge_good_ms);
+		if (ge_quiet_s > 0) {
+			g->busy = 0;
+			g->env_until_ms = now + ge_exp(g, ge_quiet_s * 1000.0);
+		}
+	}
+	while (ge_quiet_s > 0 && now >= g->env_until_ms) {
+		g->busy = !g->busy;
+		g->env_until_ms += ge_exp(g, (g->busy ? ge_busy_s : ge_quiet_s) * 1000.0);
+	}
+	while (now >= g->until_ms) {
+		g->bad = !g->bad;
+		g->until_ms += ge_exp(g, g->bad ? ge_bad_ms : (g->busy ? ge_good_ms / ge_busy_k : ge_good_ms));
+	}
+	return g->bad ? bad_p : ge_good_p;
+}
+
+static FILE *tr_f;
+static int tr_on = -1;
+static void tr_log(int s, int d, int len, double p)
+{
+	if (tr_on < 0) {
+		const char *e = getenv("WM_TRACE");
+		tr_on = e && *e;
+		if (tr_on)
+			tr_f = fopen(e, "w");
+		if (!tr_f)
+			tr_on = 0;
+	}
+	if (tr_on) {
+		fprintf(tr_f, "%.3f %d %d %d %.3f\n", ge_now_ms(), s, d, len, p);
+		fflush(tr_f);
+	}
+}
