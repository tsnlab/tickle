-	return ctx->error_prob_matrix[ctx->num_stas * src->index + dst->index];
+	double bad = ctx->error_prob_matrix[ctx->num_stas * src->index + dst->index];
+	{
+		double pe;
+		wm_frame_len = frame_len;
+		pe = ge_overlay(ctx, src->index, dst->index, bad);
+		tr_log(src->index, dst->index, frame_len, pe);
+		return pe;
+	}
 }
 
