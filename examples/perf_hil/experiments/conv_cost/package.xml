<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>conv_cost</name>
  <version>0.0.1</version>
  <description>
    RMW_PERF_PLAN.md 12's measurement tool: to_tickle / from_tickle of a large primitive sequence through the
    rosidl_typesupport_tickle_cpp handle, against a memcpy of the same bytes and rclcpp::Serialization. A package so
    that CI's clang-tidy has a compile database entry for it.
  </description>
  <maintainer email="semih@tsnlab.com">TSN Lab</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <!-- endpoint_memory (LARGE_MESSAGE_PLAN.md pass 5) links rmw_tickle::rmw_tickle. Declared here, not only as a
       find_package in CMakeLists.txt: CI builds this package in the same colcon call as rmw_tickle, and colcon orders
       that call from these declarations alone - without this line conv_cost started before rmw_tickle was installed and
       its find_package failed (6d5da13e, run 36411065518). -->
  <depend>rmw_tickle</depend>
  <depend>rosidl_typesupport_cpp</depend>
  <depend>rosidl_typesupport_tickle_c</depend>
  <depend>rosidl_typesupport_tickle_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
