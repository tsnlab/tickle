+#ifdef R4_TRACE
+// R4 investigation trace (experiment only, never production): timestamped events dumped at exit to $R4_TRACE_FILE.
+#include <stdlib.h>
+#include <time.h>
+struct r4_ev {
+    uint64_t t;
+    uint32_t a;
+    uint32_t b;
+    char k;
+};
+#define R4_EV_MAX (1U << 21)
+static struct r4_ev* r4_evs;
+static uint32_t r4_n;
+static char r4_reason = '?';
+static uint64_t r4_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+static void r4t(char k, uint32_t a, uint32_t b) {
+    if (r4_evs == NULL) {
+        r4_evs = (struct r4_ev*)calloc(R4_EV_MAX, sizeof(struct r4_ev));
+        if (r4_evs == NULL) {
+            return;
+        }
+    }
+    if (r4_n < R4_EV_MAX) {
+        r4_evs[r4_n++] = (struct r4_ev) {r4_now(), a, b, k};
+    }
+}
+__attribute__((destructor)) static void r4_dump(void) {
+    const char* path = getenv("R4_TRACE_FILE");
+    if (path == NULL || r4_evs == NULL) {
+        return;
+    }
+    // EWS (eth_storm_census.sh): unless R4_TRACE_KEEP=1, only a rep that resent, released by timeout, received as
+    // duplicates or retried on the timer far beyond a calm rep's (calm: ~7,000 S, ~3,000 T, ~3,500 D, ~1,000 I at most)
+    // writes its trace - the rest would fill the disk with root-owned files.
+    const char* keep = getenv("R4_TRACE_KEEP");
+    if (keep == NULL || keep[0] != '1') {
+        uint32_t s = 0, t = 0, d = 0, i_timer = 0;
+        for (uint32_t i = 0; i < r4_n; i++) {
+            s += r4_evs[i].k == 'S';
+            t += r4_evs[i].k == 'T';
+            d += r4_evs[i].k == 'D';
+            i_timer += r4_evs[i].k == 'I';
+        }
+        if (s < 20000U && t < 20000U && d < 50000U && i_timer < 2000U) {
+            return;
+        }
+    }
+    FILE* f = fopen(path, "w");
+    if (f == NULL) {
+        return;
+    }
+    for (uint32_t i = 0; i < r4_n; i++) {
+        fprintf(f, "%c %llu %u %u\n", r4_evs[i].k, (unsigned long long)r4_evs[i].t, r4_evs[i].a, r4_evs[i].b);
+    }
+    fclose(f);
+}
+#define R4T(k, a, b) r4t((k), (uint32_t)(a), (uint32_t)(b))
+#define R4REASON(c) (r4_reason = (c))
+#else
+#define R4T(k, a, b) ((void)0)
+#define R4REASON(c) ((void)0)
+#endif
+
