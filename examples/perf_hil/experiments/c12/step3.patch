+#ifdef TT_EXP_C12_READBACK // experiment only (c12/step3.patch): socket options read back with getsockopt()
+#define C12_UDP_GRO 104 // UDP_GRO, <linux/udp.h>, spelled out: this block is outside TT_HAL_UDP_GRO
+static int c12_gro_probe = -1; // the data socket's UDP_GRO read while gro_setup() had it on; -1: the probe never ran
+static int c12_sockopt(int fd, int level, int name) {
+    int value = -1;
+    socklen_t size = sizeof(value);
+    return getsockopt(fd, level, name, &value, &size) == 0 ? value : -2;
+}
+static void c12_readback(const struct tt_Context* node, const char* when) {
+    TT_LOG_INFO("c12 readback %s: gro_probe=%d data_gro=%d wk_gro=%d data_no_check=%d wk_no_check=%d", when, c12_gro_probe,
+                c12_sockopt(node->hal.data_sock, IPPROTO_UDP, C12_UDP_GRO), c12_sockopt(node->hal.sock, IPPROTO_UDP, C12_UDP_GRO),
+                c12_sockopt(node->hal.data_sock, SOL_SOCKET, SO_NO_CHECK),
+                c12_sockopt(node->hal.sock, SOL_SOCKET, SO_NO_CHECK));
+}
+#endif
+
