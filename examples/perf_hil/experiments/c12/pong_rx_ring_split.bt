#!/usr/bin/env bpftrace
// C12 idle wake, step 5 (2026-10-31): where an idle pong's receive spends its time, for rmw_tickle's wait ring as well as
// for a thread blocked in recvmsg (CycloneDDS). pong_rx_split.bt's receive points end at recv*'s return, which the ring
// never makes; this one also ends at io_uring_enter's, and adds the CPU's idle exit and the ring's own events.
//   bpftrace pong_rx_ring_split.bt <pong tgid> <eth0 irq>
// Times are ns after NAPI hands a received frame to the stack (net:napi_gro_receive_entry), the start of a burst:
//   irq2napi  from the latest eth0 hard IRQ to that NAPI entry
//   enq       UDP queues the datagram (__udp_enqueue_schedule_skb)      rd   the socket's data_ready (sock_def_readable)
//   tw        io_uring queues the request's task_work (io_uring:io_uring_task_add; 0 for a recvmsg waiter)
//   wk        a pong thread is woken (sched_waking), on cpu wkcpu; ie = that cpu's last idle exit in this burst (0: the cpu
//             was not idle), istate = the idle state it had entered, idle_us = how long it had been in it
//   sw        that thread is switched in
//   lw        the waiter starts running its deferred task_work (io_uring:io_uring_local_work_run; 0 for recvmsg)
//   cqe       io_uring posts a completion in a pong thread (io_uring:io_uring_complete; 0 for a recvmsg waiter)
//   rx        the receive returns to user space: io_uring_enter (ret >= 0) or recv* (ret > 0); rxtid its thread
//   khz       the woken cpu's last frequency change seen since attach (0: none seen)
//   send      a pong thread enters send*: the reply. The burst ends here; one line per reply. A burst with no reply
//             within 2 ms (an injected datagram, an announcement) is abandoned at the next NAPI entry.
BEGIN { @st = 0; printf("# pong_rx_split ring v1 tgid %d irq %d\n", $1, $2); }
tracepoint:raw_syscalls:sys_enter /pid == $1/ { @tids[tid] = 1; }
tracepoint:irq:irq_handler_entry /args->irq == $2/ { @tirq = nsecs; }
tracepoint:power:cpu_frequency { @f[args->cpu_id] = args->state; }
tracepoint:power:cpu_idle {
    if (args->state == 4294967295) {
        @ie[args->cpu_id] = nsecs;
    } else {
        @is[args->cpu_id] = args->state; @ient[args->cpu_id] = nsecs;
    }
}
tracepoint:net:napi_gro_receive_entry {
    if (@st == 0 || nsecs - @t0 > 2000000) {
        @t0 = nsecs; @st = 1; @irq2napi = nsecs - @tirq;
        @enq = 0; @rd = 0; @tw = 0; @wk = 0; @wkcpu = 0; @wtid = 0; @sw = 0; @lw = 0; @cqe = 0; @rx = 0; @rxtid = 0;
        @iex = 0; @ist = 0; @idur = 0;
    }
}
kprobe:__udp_enqueue_schedule_skb /@st == 1 && @enq == 0/ { @enq = nsecs - @t0; }
kprobe:sock_def_readable /@st == 1 && @rd == 0/ { @rd = nsecs - @t0; }
tracepoint:io_uring:io_uring_task_add /@st == 1 && @tw == 0/ { @tw = nsecs - @t0; }
tracepoint:sched:sched_waking /@st == 1 && @wk == 0 && @tids[args->pid]/ {
    @wk = nsecs - @t0; @wkcpu = args->target_cpu; @wtid = args->pid;
}
tracepoint:sched:sched_switch /@st == 1 && @wtid != 0 && args->next_pid == @wtid && @sw == 0/ {
    @sw = nsecs - @t0;
    $c = cpu;
    if (@ie[$c] > @t0) {
        @iex = @ie[$c] - @t0; @ist = @is[$c]; @idur = @ie[$c] - @ient[$c];
    }
}
tracepoint:io_uring:io_uring_local_work_run /pid == $1 && @st == 1 && @lw == 0 && @sw != 0/ { @lw = nsecs - @t0; }
tracepoint:io_uring:io_uring_complete /pid == $1 && @st == 1 && @cqe == 0/ { @cqe = nsecs - @t0; }
tracepoint:syscalls:sys_exit_io_uring_enter /pid == $1 && @st == 1 && @rx == 0 && args->ret >= 0 && @cqe != 0/ {
    @rx = nsecs - @t0; @rxtid = tid;
}
tracepoint:syscalls:sys_exit_recvfrom,tracepoint:syscalls:sys_exit_recvmsg,tracepoint:syscalls:sys_exit_recvmmsg
/pid == $1 && @st == 1 && @rx == 0 && args->ret > 0/ { @rx = nsecs - @t0; @rxtid = tid; }
tracepoint:syscalls:sys_enter_sendto,tracepoint:syscalls:sys_enter_sendmsg,tracepoint:syscalls:sys_enter_sendmmsg
/pid == $1 && @st == 1 && @rx != 0/ {
    printf("S irq2napi=%d enq=%d rd=%d tw=%d wk=%d wkcpu=%d ie=%d istate=%d idle_us=%d sw=%d lw=%d cqe=%d rx=%d rxtid=%d wtid=%d khz=%d send=%d\n",
           @irq2napi, @enq, @rd, @tw, @wk, @wkcpu, @iex, @ist, @idur / 1000, @sw, @lw, @cqe, @rx, @rxtid, @wtid, @f[@wkcpu], nsecs - @t0);
    @st = 0;
}
END { clear(@tids); clear(@f); clear(@ie); clear(@is); clear(@ient); clear(@t0); clear(@st); clear(@tirq); clear(@irq2napi);
      clear(@enq); clear(@rd); clear(@tw); clear(@wk); clear(@wkcpu); clear(@wtid); clear(@sw); clear(@lw); clear(@cqe); clear(@rx);
      clear(@rxtid); clear(@iex); clear(@ist); clear(@idur); }
