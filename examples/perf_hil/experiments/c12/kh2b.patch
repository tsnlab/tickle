 }
 
 // Said once per process, as uring_refused() says it for the readiness ring.
@@ -3734,6 +3736,14 @@ static bool wr_enable(struct tt_hal* hal, int self) {
     }
     hal->wr_owner = self;
     hal->wr_streak = 0;
+#if TT_RX_RING_FIXED_FILE
+    // The data socket as registered file 0 (TT_RX_RING_FIXED_FILE): by the owner, once the ring is enabled, as a
+    // SINGLE_ISSUER ring takes registrations from its submitter only. Refused (an old kernel, a limit): plain
