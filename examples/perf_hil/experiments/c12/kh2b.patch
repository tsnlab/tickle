diff --git a/include/tickle/hal_linux.h b/include/tickle/hal_linux.h
index fd69b996..db709f5a 100644
--- a/include/tickle/hal_linux.h
+++ b/include/tickle/hal_linux.h
@@ -209,6 +209,20 @@ static inline void tt_thread_yield(void) {
 #ifndef tt_RX_URING_WAIT
 #define tt_RX_URING_WAIT 1
 #endif
+// The wait ring's recvmsg on the data socket through a registered file (IORING_REGISTER_FILES, IOSQE_FIXED_FILE): no
+// fget() when the request is issued and no fput() when it completes, which on the Pi was ~400 cycles inside the warm
+// receive's tap -> return (C12 step 6, fput). The owner registers it when it enables the ring (wr_enable()); a refusal
+// leaves the plain descriptor. 0: the plain descriptor always (the A/B control, ab/ring-fixed-file).
+#ifndef TT_RX_RING_FIXED_FILE
+#define TT_RX_RING_FIXED_FILE 1
+#endif
+// The wait ring's recvmsg issued with IORING_RECVSEND_POLL_FIRST: armed on the socket's poll at once, without the
+// read the kernel otherwise tries first and expects to fail - the wait ring arms it only when the socket was found
+// empty (tt_receive() reads what is queued before it waits). 0: the speculative read first (the A/B control,
+// ab/ring-poll-first).
+#ifndef TT_RX_RING_POLL_FIRST
+#define TT_RX_RING_POLL_FIRST 1
+#endif
 // The ring moves to a thread whose waits read this many data-socket datagrams in a row while the owner read none (each
 // counted after its read since 2026-10-29; waits until then, which an idle owner's wait reset); each move doubles the
 // run the next one needs, up to TT_RX_RING_MOVE_MAX (hal_linux.c, "The wait ring"). 2, the shortest run that is still a
@@ -486,6 +500,7 @@ struct tt_hal {
     // wr_move_after its next wait moves the ring to it (wr_moves), and the next move needs twice the run.
     int wr_fd_plus1;
     int wr_owner;
+    bool wr_fixed; // the data socket is the ring's registered file 0 (TT_RX_RING_FIXED_FILE)
     bool wr_now;
     uint8_t wr_armed;
     uint32_t wr_recv;
