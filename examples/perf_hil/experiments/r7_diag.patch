# r7_diag.patch - C11 diagnostic (2026-10-30), never production: applied on top of r4_trace.patch to a copy of main.
# CLOCK_REALTIME events (to line up with tv_phases.txt), small-sample resends (s), reader arrivals (W), copies below the
# watermark (L) and eviction advances (B); the harness builds wifi_link_node with -DR4_TRACE under SMALL_TRACE=1.
# Read by r7_diag_read.py.
--- a/src/tickle.c	2026-10-30 00:27:21.551973307 +0900
+++ b/src/tickle.c	2026-10-30 00:32:12.737332817 +0900
@@ -41,7 +41,7 @@
 static char r4_reason = '?';
 static uint64_t r4_now(void) {
     struct timespec ts;
-    clock_gettime(CLOCK_MONOTONIC, &ts);
+    clock_gettime(CLOCK_REALTIME, &ts);
     return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
 }
 static void r4t(char k, uint32_t a, uint32_t b) {
@@ -17423,6 +17423,7 @@
     // ahead of it.
     if (seq_delta(seq_no, proxy->ack_seq_no) < 0) {
         RSTAT_INC(late_below_ack);
+        R4T('L', seq_no, node->rx_targeted);
         return true; // old relative to the ack watermark, but NOT reliable evidence of "already
                      // delivered" once jump_ack_baseline() has ever fired for this proxy - see this
                      // function's own doc comment for the real regression this specific case caused
@@ -17431,6 +17432,7 @@
     }
 
     RSTAT_ON_ARRIVAL(proxy, seq_no);
+    R4T('W', seq_no, node->rx_targeted);
     if (node->rx_targeted) {
         uint64_t now = tt_get_ns();
         note_repair_arrival(proxy, seq_no, now);
@@ -22139,6 +22141,7 @@
         RSTAT_INC(retransmit_tx_fail);
     } else {
         RSTAT_INC(retransmitted);
+        R4T('s', missing_seq_no, cache_entry->retry);
         pub->retransmitted++;
         if (cache_entry->retry < UINT8_MAX) {
             cache_entry->retry++; // how often this one was resent, for resend_suppressed()
@@ -22617,6 +22620,7 @@
         return;
     }
     uint32_t skipped = first_available_seq_no - proxy->ack_seq_no;
+    R4T('B', proxy->ack_seq_no, first_available_seq_no);
     proxy->sub->gap_evicted += skipped - received_in_first(proxy, skipped);
 #ifdef tt_RELIABLE_STATS
     {
