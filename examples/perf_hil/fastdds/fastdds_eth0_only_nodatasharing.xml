<?xml version="1.0" encoding="UTF-8"?>
<!--
  fastdds_eth0_only.xml, plus data-sharing turned OFF. A SEPARATE arm: nothing about the shipped
  configuration changes, and the figures measured with the other profiles stand as they are.

  Why it exists (2026-10-04). The eth0_only arm was being used as the kernel-path denominator -
  "this is what FastDDS costs when it has to go through the socket" - and at p4 BEST_EFFORT it is
  not one. All six S6 fastdds rows there reported wire_packets_per_sample=0.000, and the rig's own
  /dev/shm held the reason: six fast_datasharing_* segments, one per arm-run, created at 21:33:41
  through 21:34:31 against reps that started 21:33:40, 21:34:00 and 21:34:20 - including all three
  eth0_only runs.

  useBuiltinTransports=false removes the shared-memory TRANSPORT. Data-sharing is not a transport:
  it hands the reader the sample in mapped memory and never reaches the transport layer at all, so
  it survives that switch untouched. The arm was therefore measuring the same local path as the
  arm it was supposed to be the control for, and a ratio taken against it is not a ratio.

  This profile is what that denominator has to be. With data_sharing OFF on both ends a same-host
  reader has to take the sample through the socket, and the cell becomes measurable.

  How to check it did anything, rather than trusting this file: run it and look for
  /dev/shm/fast_datasharing_* on the host. The other profiles create one per participant; this one
  must create none. That is the same observation that found the problem, used as its own test.

  Nothing here changes the transport setup - the descriptor and whitelist are copied verbatim from
  fastdds_eth0_only.xml so the two arms differ in exactly one property.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>eth0_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.10.2</address>
        <address>192.168.10.3</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="eth0_only_nodsh_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>eth0_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <!-- The harnesses build their QoS from DATAWRITER_QOS_DEFAULT / DATAREADER_QOS_DEFAULT, which
       Fast DDS resolves from the default profiles below when this file is the one named by
       FASTRTPS_DEFAULT_PROFILES_FILE. Both ends are set: data-sharing needs agreement, so the
       writer alone would be enough to stop it, but a reader that still offers it would leave the
       next reader of this file wondering which side decided. -->
  <data_writer profile_name="nodsh_writer" is_default_profile="true">
    <qos>
      <data_sharing>
        <kind>OFF</kind>
      </data_sharing>
    </qos>
  </data_writer>
  <data_reader profile_name="nodsh_reader" is_default_profile="true">
    <qos>
      <data_sharing>
        <kind>OFF</kind>
      </data_sharing>
    </qos>
  </data_reader>
</profiles>
