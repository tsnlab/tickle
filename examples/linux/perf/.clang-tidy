# Bulk.c/Bulk.h in this directory are generated (tools/typesupport, from examples/Bulk.msg) -
# every offset/capacity/size in a wire codec is exactly that, a wire number, so naming each one
# would be noise rather than clarity (the same reasoning tools/typesupport/tests/golden/.clang-
# tidy and tests/.clang-tidy already use for the same check). Their own naming already satisfies
# the repo-root .clang-tidy's existing `(SetBool|UInt64|Ping|Bulk).*` whitelist, so nothing needed
# for that here.
#
# This is a placeholder for what tools/typesupport/PLAN.md's M5 milestone makes permanent
# (examples/.clang-tidy, once every hand-written codec is replaced and generated code is
# flattened into its own examples/<proto>/ directories, separate from hand-written drivers) -
# scoped narrowly to this one directory in the meantime, since perf_client.c/perf_server.c here
# are still hand-written and should keep the real check.
InheritParentConfig: true
Checks: '-readability-magic-numbers'
