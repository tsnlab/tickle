Checks: '-*,misc-*,modernize-*,-modernize-macro-to-enum,performance-*,readability-*,bugprone-*,-bugprone-easily-swappable-parameters,llvm-include-order'
CheckOptions:
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '^_tt_.*'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^_?tt_.*'
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  # Same exemption Struct/Function/EnumConstant below already carry: names carrying this library's
  # own tt_ API prefix set their own case, and a public enum type is named like the struct it
  # belongs to (enum tt_WriterKeepAll next to struct tt_WriterProxy). Enum was the one category
  # missing it - not a decision, just untested, since hal.h's tt_ret_t is lower_case anyway and was
  # the only named enum in a public header until now.
  - key: readability-identifier-naming.EnumIgnoredRegexp
    value: '^_?tt_.*'
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantIgnoredRegexp
    value: '^tt_.*'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^tt_.*'
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '^tt_.*'
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case
  - key: readability-identifier-naming.GlobalVariableIgnoredRegexp
    value: '^_?tt_.*'
  - key: readability-identifier-naming.ConstantCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^DEBUG$|^_?tt_.*'
  - key: readability-identifier-length.IgnoredParameterNames
    value: '^(id|ip|ts|[abijkpqr])$'
  - key: readability-identifier-length.IgnoredVariableNames
    value: '^(id|ip|ts|[A-Zijkpqr])$'
  - key: readability-identifier-naming.LocalVariableIgnoredRegexp
    value: '^(id|ip|ts|[A-Zijkpqr])$'
  - key: readability-magic-numbers.IgnoredIntegerValues
    value: '1;2;3;4;5;8;10;16;24;32;255'
  - key: misc-include-header.MissingIncludes
    value: false
  # lwIP's public API is a small set of umbrella headers (lwip/sockets.h, lwip/netif.h, ...) that
  # deliberately re-export names from private sub-headers; misc-include-cleaner's "include the
  # exact provider" rule fights that design in hal_freertos.c. Suppress it for lwip/ only.
  # rclcpp/rclcpp.hpp is the identical case for rmw_perf_pingpong's ping_node.cpp/pong_node.cpp -
  # ROS 2's own documented way to use rclcpp is this one umbrella include, not each symbol's own
  # private sub-header (rclcpp/node.hpp, rclcpp/qos.hpp, ...).
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'lwip/.*|rclcpp/.*'
  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: true
