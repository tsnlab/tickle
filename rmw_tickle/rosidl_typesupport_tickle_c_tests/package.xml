<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>rosidl_typesupport_tickle_c_tests</name>
  <version>0.0.1</version>
  <description>
    A minimal real ROS 2 interface package that exists purely to prove, in CI, that a message
    generated by rosidl_typesupport_tickle_c is actually reachable through the standard
    get_message_typesupport_handle() dispatch chain a real rmw_create_publisher() call would use -
    not just that the generator's own output compiles (rmw_tickle/PLAN.md's Milestone 1(b)/(c)).
    Not meant to ship or be depended on by anything else.
  </description>
  <maintainer email="halim9512@gmail.com">Harim Seong</maintainer>
  <license>GPL-3.0-or-later</license>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rosidl_default_generators (what a real interface package normally depends on) transitively
       pulls in rosidl_generator_py/_rs and ament_cmake_python's own egg-build step - none of which
       rosidl_typesupport_tickle_c needs, and which need Python packages (setuptools) this CI
       environment's actions/setup-python interpreter doesn't have. rosidl_generator_c +
       rosidl_typesupport_c are the two actually needed: the former for the message struct this
       package's own test_dispatch.c includes, the latter for ROSIDL_GET_MSG_TYPE_SUPPORT()'s
       standard dispatch entry point. -->
  <buildtool_depend>rosidl_cmake</buildtool_depend>

  <depend>rosidl_generator_c</depend>
  <depend>rosidl_typesupport_c</depend>
  <depend>rosidl_typesupport_tickle_c</depend>
  <!-- rosidl_generator_cpp/rosidl_typesupport_cpp: needed for test_dispatch_cpp.cpp, which
       exercises the *actual* entry point a real rclcpp::Node uses (rosidl_typesupport_cpp::
       get_message_type_support_handle<T>()) rather than the C-only ROSIDL_GET_MSG_TYPE_SUPPORT()
       macro test_dispatch.c uses - the C-only path stayed reachable throughout the whole
       rosidl_typesupport_tickle_cpp gap this test package's own history didn't catch, since it
       never went through the C++ dispatch at all. See rosidl_typesupport_tickle_cpp's own
       package.xml doc comment for the full story. -->
  <depend>rosidl_generator_cpp</depend>
  <depend>rosidl_typesupport_cpp</depend>
  <depend>rosidl_typesupport_tickle_cpp</depend>
  <!-- srv/SimpleService.srv - rosidl_generate_interfaces() itself requires this for any .srv
       (rosidl_cmake/cmake/rosidl_generate_interfaces.cmake's own "Services depend on
       service_msgs" check). -->
  <depend>service_msgs</depend>

  <exec_depend>rosidl_runtime_c</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
